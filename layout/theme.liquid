<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-poster-shopify>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title | escape }}</title>
    {{ content_for_header }}
    {{ 'poster-home.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main>
      <div class="top-shell" data-poster-header-shell>{% sections 'header-group' %}</div>
      {{ content_for_layout }}
      {% sections 'footer-group' %}
      <div id="root"></div>
    </main>
    <script type="module" src="{{ 'poster-home.js' | asset_url }}"></script>
  </body>
</html>
