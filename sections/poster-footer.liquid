{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{"id":{{ block.id | json }},"heading":{{ block.settings.heading | json }},"links":[{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}{% unless forloop.first %},{% endunless %}{"title":{{ link.title | json }},"url":{{ link.url | json }}}{% endfor %}{% else %}{% assign first_link = true %}{% for i in (1..5) %}{% assign label_key = 'link_' | append: i | append: '_label' %}{% assign url_key = 'link_' | append: i | append: '_url' %}{% assign label = block.settings[label_key] %}{% assign url = block.settings[url_key] %}{% if label != blank %}{% unless first_link %},{% endunless %}{"title":{{ label | json }},"url":{{ url | json }},"fallback":true}{% assign first_link = false %}{% endif %}{% endfor %}{% endif %}]}{% endfor %}]{% endcapture %}
<div data-poster-section="Footer" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}" data-poster-blocks="{{ poster_blocks | escape }}"></div>
{% schema %}
{
  "name": "页脚",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "品牌名称",
      "default": "ODD WALL"
    },
    {
      "type": "text",
      "id": "logo_accent",
      "label": "品牌名称强调符号",
      "default": "!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "品牌简介",
      "default": "Independent art prints for loud minds, blank walls, and people who think a little sideways."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "显示订阅区",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "订阅区标题",
      "default": "GOOD STUFF, OCCASIONALLY."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "邮箱输入提示",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "版权文字",
      "default": "© 2026 ODD WALL STUDIO"
    },
    {
      "type": "text",
      "id": "bottom_message",
      "label": "底部说明",
      "default": "PRINTED WITH CARE. SHIPPED WORLDWIDE."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "返回顶部文字",
      "default": "Back to top ↑"
    },
    {
      "type": "text",
      "id": "back_url",
      "label": "返回顶部链接",
      "default": "#top"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "菜单",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "菜单标题",
          "default": "MENU"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "选择 Shopify 菜单"
        },
        {
          "type": "paragraph",
          "content": "未选择 Shopify 菜单时，显示下面填写的链接。"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "链接 1 文字"
        },
        {
          "type": "text",
          "id": "link_1_url",
          "label": "链接 1 地址"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "链接 2 文字"
        },
        {
          "type": "text",
          "id": "link_2_url",
          "label": "链接 2 地址"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "链接 3 文字"
        },
        {
          "type": "text",
          "id": "link_3_url",
          "label": "链接 3 地址"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "链接 4 文字"
        },
        {
          "type": "text",
          "id": "link_4_url",
          "label": "链接 4 地址"
        },
        {
          "type": "text",
          "id": "link_5_label",
          "label": "链接 5 文字"
        },
        {
          "type": "text",
          "id": "link_5_url",
          "label": "链接 5 地址"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "presets": [
    {
      "name": "页脚",
      "blocks": [
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
