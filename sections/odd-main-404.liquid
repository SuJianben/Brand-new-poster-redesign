{{ 'odd-404.css' | asset_url | stylesheet_tag }}
<section class="odd-404">
  <div class="odd-404__inner">
    <div class="odd-404__copy">
      <p class="odd-404__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.description != blank %}<p class="odd-404__description">{{ section.settings.description | escape | newline_to_br }}</p>{% endif %}
      <div class="odd-404__actions">
        <a class="odd-404__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
        <a class="odd-404__home" href="{{ routes.root_url }}">{{ section.settings.home_label | escape }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="odd-404__visual" aria-hidden="true">
      <span class="odd-404__spark">✳</span>
      <div class="odd-404__poster"><span class="odd-404__number">4<span>0</span>4</span><span class="odd-404__poster-caption">{{ section.settings.poster_text | escape }}</span></div>
      <span class="odd-404__sticker">{{ section.settings.sticker_text | escape }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "404 页面",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "标题上方文字", "default": "WRONG TURN. RIGHT PLACE." },
    { "type": "text", "id": "heading", "label": "标题", "default": "THIS PAGE WENT OFF THE WALL." },
    { "type": "textarea", "id": "description", "label": "说明文字", "default": "We can't find the page you're looking for. But there's plenty more to see." },
    { "type": "text", "id": "button_label", "label": "主按钮文字", "default": "SHOP THE PRINTS" },
    { "type": "url", "id": "button_link", "label": "主按钮链接" },
    { "type": "text", "id": "home_label", "label": "返回首页文字", "default": "BACK TO HOME" },
    { "type": "text", "id": "poster_text", "label": "海报文字", "default": "LOST IN THOUGHT." },
    { "type": "text", "id": "sticker_text", "label": "贴纸文字", "default": "NOT FOUND" }
  ]
}
{% endschema %}
