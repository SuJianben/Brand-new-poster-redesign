{{ 'poster-community-modal.css' | asset_url | stylesheet_tag }}
{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{"id":{{ block.id | json }},"settings":{"image":{{ block.settings.image | json }},"alt":{{ block.settings.alt | json }},"handle":{{ block.settings.handle | json }},"credit":{{ block.settings.credit | json }},"link_url":{{ block.settings.link_url | append: '' | json }}},"image":{% if block.settings.custom_image != blank %}{{ block.settings.custom_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"products":[{% for item in block.settings.products %}{% unless forloop.first %},{% endunless %}{"id":{{ item.id | json }},"title":{{ item.title | json }},"url":{{ item.url | append: '' | json }},"price":{{ item.price | money | json }},"price_varies":{{ item.price_varies | json }},"image":{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}}{% endfor %}]}{% endfor %}]{% endcapture %}
<div data-poster-section="Community" data-poster-id="{{ section.id }}" data-poster-blocks="{{ poster_blocks | escape }}" data-poster-settings="{{ section.settings | json | escape }}"></div>
{% schema %}
{
  "name": "社区展示",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Good walls, great people."
    }
  ],
  "presets": [
    {
      "name": "社区展示"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "条目",
      "settings": [
        {
          "type": "product_list",
          "id": "products",
          "label": "关联商品",
          "info": "选择这张图片中展示的商品。",
          "limit": 20
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "社媒原帖链接"
        },
        {
          "type": "text",
          "id": "image",
          "label": "图片链接"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "图片描述"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "账号"
        },
        {
          "type": "text",
          "id": "credit",
          "label": "图片署名"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "上传图片（优先于图片链接）"
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
