{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{"settings":{{ block.settings | json }},"image":{% if block.settings.custom_image != blank %}{{ block.settings.custom_image | image_url: width: 1600 | json }}{% else %}null{% endif %}}{% endfor %}]{% endcapture %}
<div data-poster-section="Community" data-poster-id="{{ section.id }}" data-poster-blocks="{{ poster_blocks | escape }}" data-poster-settings="{{ section.settings | json | escape }}"></div>
{% schema %}
{
  "name": "社区展示",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Good walls, great people."
    }
  ],
  "presets": [
    {
      "name": "社区展示"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "条目",
      "settings": [
        {
          "type": "url",
          "id": "link_url",
          "label": "跳转链接"
        },
        {
          "type": "text",
          "id": "image",
          "label": "图片链接"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "图片描述"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "账号"
        },
        {
          "type": "text",
          "id": "credit",
          "label": "图片署名"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "上传图片（优先于图片链接）"
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
