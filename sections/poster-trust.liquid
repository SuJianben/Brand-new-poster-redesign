{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{"settings":{{ block.settings | json }},"image":null}{% endfor %}]{% endcapture %}
<div data-poster-section="Trust" data-poster-id="{{ section.id }}" data-poster-blocks="{{ poster_blocks | escape }}" data-poster-settings="{{ section.settings | json | escape }}"></div>
{% schema %}
{
  "name": "信任信息",
  "settings": [
    {"type":"checkbox","id":"show_score","label":"显示评分块","default":true},
    {"type":"text","id":"heading","label":"标题","default":"TRUST THE PROCESS"},
    {"type":"text","id":"score","label":"评分","default":"4.9"},
    {"type":"textarea","id":"description","label":"评分说明","default":"Based on 1,200+ very opinionated walls."}
  ],
  "blocks": [{"type":"item", "name":"信任条目", "settings": [
    {"type":"select","id":"icon","label":"图标","default":"paper","options":[
      {"value":"paper","label":"纸张"}, {"value":"leaf","label":"环保"},
      {"value":"shipping","label":"配送"}, {"value":"return","label":"退货"}
    ]},
    {"type":"text","id":"title","label":"标题","default":"Museum-grade paper"},
    {"type":"textarea","id":"description","label":"说明","default":"Heavy, tactile 230gsm stock with rich pigment inks that stay loud."}
  ]}],
  "max_blocks": 4,
  "presets": [{"name":"信任信息","blocks":[
    {"type":"item","settings":{"icon":"paper","title":"Museum-grade paper","description":"Heavy, tactile 230gsm stock with rich pigment inks that stay loud."}},
    {"type":"item","settings":{"icon":"leaf","title":"Printed responsibly","description":"FSC-certified paper, water-based inks, and plastic-free packaging."}},
    {"type":"item","settings":{"icon":"shipping","title":"Ships worldwide","description":"Tracked delivery in protective tubes. Free shipping over $75."}},
    {"type":"item","settings":{"icon":"return","title":"30-day returns","description":"Changed your mind? Send it back, no awkward questions attached."}}
  ]}]
}
{% endschema %}
