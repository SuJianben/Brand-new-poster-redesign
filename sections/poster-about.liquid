<div data-poster-section="About" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}"
  {% if section.settings.image != blank %}data-poster-image="{{ section.settings.image | image_url: width: 1600 | escape }}"{% endif %}></div>
{% schema %}
{
  "name": "品牌介绍",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Ideas belong out in the open."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "品牌图片"
    }
  ],
  "presets": [
    {
      "name": "品牌介绍"
    }
  ]
}
{% endschema %}
