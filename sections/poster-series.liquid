{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{% assign selected_collection = block.settings.collection %}{"id":{{ block.id | json }},"settings":{{ block.settings | json }},"image":{% if block.settings.custom_image != blank %}{{ block.settings.custom_image | image_url: width: 1600 | json }}{% elsif selected_collection.featured_image != blank %}{{ selected_collection.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"collection":{% if selected_collection != blank %}{"title":{{ selected_collection.title | json }},"url":{{ selected_collection.url | append: "" | json }},"count":{{ selected_collection.all_products_count | json }}}{% else %}null{% endif %}}{% endfor %}]{% endcapture %}
<div data-poster-section="Series" data-poster-id="{{ section.id }}" data-poster-blocks="{{ poster_blocks | escape }}" data-poster-settings="{{ section.settings | json | escape }}"></div>
{% schema %}
{
  "name": "系列展示",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Pick your department."
    }
  ],
  "presets": [
    {
      "name": "系列展示"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "条目",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "选择产品系列",
          "info": "选择后自动显示系列名称、商品数量和系列链接；上传图片可覆盖系列图片。"
        },
        {
          "type": "text",
          "id": "number",
          "label": "编号"
        },
        {
          "type": "text",
          "id": "name",
          "label": "系列名称（未选系列时使用）"
        },
        {
          "type": "text",
          "id": "category",
          "label": "分类"
        },
        {
          "type": "text",
          "id": "count",
          "label": "数量文字（未选系列时使用）"
        },
        {
          "type": "text",
          "id": "line",
          "label": "说明"
        },
        {
          "type": "color",
          "id": "color",
          "label": "背景颜色",
          "default": "#6c5ce7"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "跳转链接（未选系列时使用）"
        },
        {
          "type": "text",
          "id": "image",
          "label": "图片链接"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "上传图片（优先于系列图片）"
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
