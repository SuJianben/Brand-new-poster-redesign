{%- assign limit = section.settings.product_limit -%}
{{ 'poster-shop-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'poster-shop-tabs.js' | asset_url }}" defer></script>
<section class="shop-section poster-shop" id="shop" data-poster-shop>
  <div class="section-heading">
    <div><h2>{{ section.settings.heading | escape }}</h2></div>
    {% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle | escape | newline_to_br }}</p>{% endif %}
  </div>
  {% if section.blocks.size > 0 %}
    <div class="filters" role="tablist" aria-label="Poster categories">
      {% for block in section.blocks %}
        {% assign label = block.settings.label | default: block.settings.collection.title | default: 'Collection' %}
        <button type="button" role="tab" id="shop-tab-{{ section.id }}-{{ block.id }}" aria-controls="shop-panel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" class="{% if forloop.first %}active{% endif %}" data-shop-tab {{ block.shopify_attributes }}>{{ label | escape }}</button>
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      <div id="shop-panel-{{ section.id }}-{{ block.id }}" role="tabpanel" aria-labelledby="shop-tab-{{ section.id }}-{{ block.id }}" data-shop-panel {% unless forloop.first %}hidden{% endunless %}>
        {% if block.settings.collection != blank %}
          <div class="product-grid product-grid-animated">
            {% for card_product in block.settings.collection.products limit: limit %}
              {% render 'odd-recommendation-card', product: card_product, index: forloop.index %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  {% endif %}
</section>
{% schema %}
{
  "name": "商品展示",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Fresh off the press" },
    { "type": "textarea", "id": "subtitle", "label": "说明", "default": "No answers to life,\njust better walls." },
    { "type": "range", "id": "product_limit", "label": "每个分类展示商品数", "min": 3, "max": 24, "step": 3, "default": 6 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "分类标签",
      "settings": [
        { "type": "text", "id": "label", "label": "标签名称", "info": "留空时显示所选产品系列的名称。" },
        { "type": "collection", "id": "collection", "label": "产品系列" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "商品展示" }]
}
{% endschema %}
