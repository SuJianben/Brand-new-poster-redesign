{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{% assign hero_product = block.settings.product %}{% assign hero_original = blank %}{% if hero_product != blank %}{% capture hero_original %}{% render 'pf-black-frame-artwork', product: hero_product, slot: 'url' %}{% endcapture %}{% assign hero_original = hero_original | strip | default: hero_product.metafields.custom.hanger_original_artwork_url.value %}{% endif %}{"id":{{ block.id | json }},"settings":{{ block.settings | json }},"cta_link":{{ block.settings.cta_link | append: "" | json }},"image":{% if block.settings.custom_image != blank %}{{ block.settings.custom_image | image_url: width: 1600 | json }}{% elsif hero_original != blank %}{{ hero_original | json }}{% elsif hero_product.featured_image != blank %}{{ hero_product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %}}{% endfor %}]{% endcapture %}
<div data-poster-section="Hero" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}" data-poster-blocks="{{ poster_blocks | escape }}"></div>
{% schema %}
{
  "name": "首页轮播",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播图",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "上方短标题",
          "default": "ART FOR LOUD MINDS"
        },
        {
          "type": "text",
          "id": "title",
          "label": "主标题",
          "default": "YOUR WALLS"
        },
        {
          "type": "text",
          "id": "outline",
          "label": "描边标题",
          "default": "HATE BORING"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "描述",
          "default": "Pull philosophy off the shelf and put it on the wall. Original art prints that speak before you do."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "按钮文字",
          "default": "Shop philosophy"
        },
        {
          "type": "text",
          "id": "category",
          "label": "按钮对应的演示分类",
          "default": "Philosophy"
        },
        {
          "type": "color",
          "id": "color",
          "label": "背景颜色",
          "default": "#6c5ce7"
        },
        {
          "type": "text",
          "id": "image",
          "label": "图片链接",
          "default": "https://images.unsplash.com/photo-1626803302532-b83560c4d946?auto=format&fit=crop&w=1200&q=90"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "图片说明",
          "default": "Creative philosophy poster featuring a classical statue"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "海报上方文字",
          "default": "THE ART OF"
        },
        {
          "type": "text",
          "id": "poster_title",
          "label": "海报标题",
          "default": "THINKING"
        },
        {
          "type": "text",
          "id": "poster_line",
          "label": "海报底部文字",
          "default": "THINKING IS A STREET SPORT."
        },
        {
          "type": "text",
          "id": "number",
          "label": "海报编号",
          "default": "001"
        },
        {
          "type": "text",
          "id": "mark",
          "label": "装饰符号",
          "default": "?"
        },
        {
          "type": "text",
          "id": "sticker",
          "label": "圆形贴纸文字",
          "default": "ONLY 100 MADE"
        },
        {
          "type": "product",
          "id": "product",
          "label": "选择商品",
          "info": "优先显示商品原始画作，无原画时显示商品首图；上传图片后优先显示上传的图片。"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "上传图片（优先于商品首图）"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "按钮链接"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "首页轮播",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
