<div data-poster-section="Header" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}"></div>
{% schema %}
{
  "name": "页头",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "公告文字",
      "default": "FREE WORLDWIDE SHIPPING OVER $75"
    },
    {
      "type": "text",
      "id": "announcement_center",
      "label": "中间公告",
      "default": "NEW DROP: THINKING IS A STREET SPORT"
    },
    {
      "type": "text",
      "id": "shop_link_label",
      "label": "Shop all文字",
      "default": "Shop all"
    },
    {
      "type": "text",
      "id": "shop_link_url",
      "label": "Shop all链接",
      "default": "#shop"
    },
    {
      "type": "text",
      "id": "events_link_label",
      "label": "Events文字",
      "default": "Events"
    },
    {
      "type": "text",
      "id": "events_link_url",
      "label": "Events链接",
      "default": "#manifesto"
    },
    {
      "type": "text",
      "id": "collections_link_label",
      "label": "Collections文字",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "collections_link_url",
      "label": "Collections链接",
      "default": "#series"
    }
  ],
  "presets": [
    {
      "name": "页头"
    }
  ]
}
{% endschema %}
