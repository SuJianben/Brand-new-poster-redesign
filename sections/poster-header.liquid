{% if section.settings.main_menu != blank %}
  {% capture poster_menu %}[{% for link in section.settings.main_menu.links %}{% unless forloop.first %},{% endunless %}{"title":{{ link.title | json }},"url":{{ link.url | json }},"children":[{% for child in link.links %}{% unless forloop.first %},{% endunless %}{"title":{{ child.title | json }},"url":{{ child.url | json }},{% render 'header-menu-preview', menu_link: child %},"children":[{% for grandchild in child.links %}{% unless forloop.first %},{% endunless %}{"title":{{ grandchild.title | json }},"url":{{ grandchild.url | json }},"children":[]}{% endfor %}]}{% endfor %}]}{% endfor %}]{% endcapture %}
{% endif %}
<div data-poster-section="Header" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}"{% if section.settings.main_menu != blank %} data-poster-menu="{{ poster_menu | escape }}"{% endif %}></div>
{% schema %}
{
  "name": "页头",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "主导航菜单",
      "info": "选择 Shopify 菜单；菜单中的子项会显示为下拉菜单。未选择时保留现有导航。"
    },
    {
      "type": "url",
      "id": "journal_link_url",
      "label": "Journal链接"
    },
    {
      "type": "url",
      "id": "about_link_url",
      "label": "About链接"
    },
    {
      "type": "url",
      "id": "all_posters_url",
      "label": "All posters链接"
    },
    {
      "type": "url",
      "id": "browse_collections_url",
      "label": "Browse collections链接"
    },
    {
      "type": "url",
      "id": "our_collections_url",
      "label": "Our collections链接"
    },
    {
      "type": "url",
      "id": "community_url",
      "label": "Community链接"
    },
    {
      "type": "url",
      "id": "our_story_url",
      "label": "Our story链接"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQ链接"
    },
    {
      "type": "text",
      "id": "shop_link_label",
      "label": "Shop all文字",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_link_url",
      "label": "Shop all链接"
    },
    {
      "type": "text",
      "id": "events_link_label",
      "label": "Events文字",
      "default": "Events"
    },
    {
      "type": "url",
      "id": "events_link_url",
      "label": "Events链接"
    },
    {
      "type": "text",
      "id": "collections_link_label",
      "label": "Collections文字",
      "default": "Collections"
    },
    {
      "type": "url",
      "id": "collections_link_url",
      "label": "Collections链接"
    }
  ],
  "presets": [
    {
      "name": "页头"
    }
  ]
}
{% endschema %}
