{% assign pf_material_route_product = product %}
{% capture pf_material_pair_status %}{% render 'pf-material-pair-valid', product: product %}{% endcapture %}
{% assign pf_material_pair_status = pf_material_pair_status | strip %}
{% if pf_material_pair_status == 'true' and product.metafields.custom.paper_product.value != blank %}
  {% assign product = product.metafields.custom.paper_product.value %}
{% endif %}
{% if pf_material_route_product.template_suffix == 'pf-paired-canvas' and pf_material_pair_status != 'true' %}
  {% render 'pf-material-pair-unavailable', product: pf_material_route_product %}
{% else %}
{% capture hanger_rollout_status %}{% render 'product-hanger-rollout-status', product: product %}{% endcapture %}
{% assign hanger_rollout_status = hanger_rollout_status | strip %}
{% assign hanger_rollout_enabled = false %}
{% if hanger_rollout_status == 'enabled' %}
  {% assign hanger_rollout_enabled = true %}
  {% assign hanger_original_media_id = product.metafields.custom.hanger_original_media_id.value | split: '/' | last %}
{% endif %}
{% capture pf_original_artwork_fields %}{% render 'pf-black-frame-artwork', product: product, slot: 'fields' %}{% endcapture %}
{% assign pf_original_artwork_fields = pf_original_artwork_fields | strip %}
{% assign pf_original_artwork_enabled = false %}
{% if pf_original_artwork_fields != blank %}
  {% assign pf_original_artwork_enabled = true %}
  {% assign pf_original_artwork_fields = pf_original_artwork_fields | split: '|' %}
  {% assign pf_original_width = pf_original_artwork_fields[0] | plus: 0 %}
  {% assign pf_original_height = pf_original_artwork_fields[1] | plus: 0 %}
  {% assign pf_original_media_id = pf_original_artwork_fields[2] %}
  {% assign pf_old_hanger_media_id = pf_original_artwork_fields[3] %}
  {% assign pf_hidden_media_ids = pf_original_artwork_fields[4] | default: pf_old_hanger_media_id | split: ',' %}
  {% capture pf_original_artwork_url %}{% render 'pf-black-frame-artwork', product: product, slot: 'url' %}{% endcapture %}
  {% assign pf_original_artwork_url = pf_original_artwork_url | strip %}
  {% if pf_original_artwork_url == blank %}{% assign pf_original_artwork_url = product.metafields.custom.hanger_original_artwork_url.value %}{% endif %}
  {% assign pf_original_ratio = pf_original_width | times: 1.0 | divided_by: pf_original_height %}
  {% assign pf_original_orientation = 'square' %}
  {% if pf_original_ratio > 1.08 %}{% assign pf_original_orientation = 'landscape' %}{% elsif pf_original_ratio < 0.92 %}{% assign pf_original_orientation = 'portrait' %}{% endif %}
{% endif %}
{% assign framing_render_mode = 'image' %}
{% if section.settings.enable_css_framing_preview %}
  {% assign framing_render_mode = 'css' %}
{% endif %}
<link rel="stylesheet" href="{{ 'product-showcase.css' | asset_url }}&psv=default-css-mat-scale-v1-20260819">
