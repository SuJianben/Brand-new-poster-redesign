{{ 'poster-event-feature.css' | asset_url | stylesheet_tag }}
{% capture poster_blocks %}[{% for block in section.blocks %}{% unless forloop.first %},{% endunless %}{"id":{{ block.id | json }},"settings":{{ block.settings | json }},"image":{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1800 | json }}{% else %}null{% endif %},"link_url":{{ block.settings.link_url | append: '' | json }}}{% endfor %}]{% endcapture %}
<div data-poster-section="Event" data-poster-id="{{ section.id }}" data-poster-settings="{{ section.settings | json | escape }}" data-poster-blocks="{{ poster_blocks | escape }}"
  {% if section.settings.image_one != blank %}data-poster-image-one="{{ section.settings.image_one | image_url: width: 1600 | escape }}"{% endif %}
  {% if section.settings.image_two != blank %}data-poster-image-two="{{ section.settings.image_two | image_url: width: 1600 | escape }}"{% endif %}></div>
{% schema %}
{
  "name": "活动图片",
  "settings": [
    { "type": "text", "id": "heading", "label": "分区标题", "default": "CURATED PRINTS" },
    { "type": "text", "id": "eyebrow", "label": "上方短标题", "default": "FEATURED COLLECTIONS" },
    { "type": "checkbox", "id": "autoplay", "label": "自动切换", "default": true },
    { "type": "range", "id": "interval", "label": "切换间隔（秒）", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "header", "content": "原有图片（未添加内容时使用）" },
    { "type": "url", "id": "link_one", "label": "第一张图片链接" },
    { "type": "url", "id": "link_two", "label": "第二张图片链接" },
    { "type": "image_picker", "id": "image_one", "label": "第一张图片" },
    { "type": "image_picker", "id": "image_two", "label": "第二张图片" }
  ],
  "blocks": [{
    "type": "slide",
    "name": "展示内容",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "图片" },
      { "type": "text", "id": "title", "label": "标题", "default": "ART THAT SPEAKS UP." },
      { "type": "textarea", "id": "description", "label": "说明", "default": "Find the print that gives your space a voice." },
      { "type": "text", "id": "button_label", "label": "按钮文字", "default": "EXPLORE PRINTS" },
      { "type": "url", "id": "link_url", "label": "按钮链接" }
    ]
  }],
  "max_blocks": 12,
  "presets": [{ "name": "活动图片" }]
}
{% endschema %}
