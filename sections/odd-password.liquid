<div class="odd-password">
  <header class="odd-password__header">
    <div class="odd-password__brand">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'odd-password__logo', widths: '180, 300, 450, 600', alt: shop.name }}
      {% else %}
        <span class="odd-password__wordmark">{{ shop.name | escape }}</span><span class="odd-password__mark" aria-hidden="true">!</span>
      {% endif %}
    </div>
    {% if section.settings.header_note != blank %}<span class="odd-password__header-note">{{ section.settings.header_note | escape }}</span>{% endif %}
  </header>

  <div class="odd-password__content">
    <div class="odd-password__copy">
      {% if section.settings.eyebrow != blank %}<p class="odd-password__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if shop.password_message != blank %}
        <div class="odd-password__description">{{ shop.password_message }}</div>
      {% elsif section.settings.description != blank %}
        <div class="odd-password__description">{{ section.settings.description | escape | newline_to_br }}</div>
      {% endif %}

      {% form 'storefront_password', class: 'odd-password__form' %}
        <label for="Password-{{ section.id }}">{{ section.settings.password_label | escape }}</label>
        {% if form.errors %}<div class="odd-password__errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="odd-password__fields">
          <input id="Password-{{ section.id }}" type="password" name="password" autocomplete="current-password" placeholder="{{ section.settings.password_placeholder | escape }}" required>
          <button type="submit">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></button>
        </div>
      {% endform %}
    </div>

    <div class="odd-password__visual" aria-hidden="true">
      <span class="odd-password__star">✳</span>
      <div class="odd-password__poster">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'odd-password__image', widths: '500, 800, 1100, 1400', sizes: '(max-width: 750px) 80vw, 38vw', loading: 'eager', alt: '' }}
        {% else %}
          <div class="odd-password__art"><span>ART FOR<br>LOUD<br>MINDS<span class="odd-password__art-dot">.</span></span></div>
        {% endif %}
        <p>{{ section.settings.poster_caption | escape }}</p>
      </div>
      <span class="odd-password__sticker">{{ section.settings.sticker | escape }}</span>
    </div>
  </div>
  <footer class="odd-password__footer"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ section.settings.footer_note | escape }}</span></footer>
</div>

{% schema %}
{
  "name": "密码页",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "品牌标志" },
    { "type": "text", "id": "header_note", "label": "页头提示", "default": "SOMETHING GOOD IS COMING" },
    { "type": "text", "id": "eyebrow", "label": "标题上方文字", "default": "A LITTLE PAUSE. A LOT OF IDEAS." },
    { "type": "text", "id": "heading", "label": "标题", "default": "GOOD THINGS ARE ON THE WAY." },
    { "type": "textarea", "id": "description", "label": "说明文字", "default": "We're getting something special ready. See you on the other side." },
    { "type": "text", "id": "password_label", "label": "密码输入标题", "default": "HAVE A PASSWORD?" },
    { "type": "text", "id": "password_placeholder", "label": "密码输入提示", "default": "Enter your password" },
    { "type": "text", "id": "button_label", "label": "按钮文字", "default": "ENTER" },
    { "type": "image_picker", "id": "image", "label": "海报图片" },
    { "type": "text", "id": "poster_caption", "label": "海报文字", "default": "MAKE YOUR WALL TALK." },
    { "type": "text", "id": "sticker", "label": "贴纸文字", "default": "COMING SOON" },
    { "type": "text", "id": "footer_note", "label": "页脚文字", "default": "GOOD THINGS TAKE TIME." }
  ]
}
{% endschema %}
