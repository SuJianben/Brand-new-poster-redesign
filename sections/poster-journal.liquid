{{ 'poster-journal-mobile.css' | asset_url | stylesheet_tag }}
{% assign selected_blog = section.settings.blog %}
{% capture poster_settings %}{"heading":{{ section.settings.heading | json }},"blog_url":{% if selected_blog != blank %}{{ selected_blog.url | append: '' | json }}{% else %}null{% endif %}}{% endcapture %}
{% capture poster_articles %}[{% for article in selected_blog.articles limit: section.settings.article_limit %}{% unless forloop.first %},{% endunless %}{% assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncate: 140 %}{% assign article_alt = article.image.alt | default: article.title %}{"settings":{"tag":{{ article.tags.first | default: selected_blog.title | json }},"date":{{ article.published_at | date: '%b %d, %Y' | json }},"title":{{ article.title | json }},"excerpt":{{ article_excerpt | json }},"alt":{{ article_alt | json }},"credit":"","link_url":{{ article.url | append: '' | json }}},"image":{% if article.image != blank %}{{ article.image | image_url: width: 1400 | json }}{% else %}null{% endif %}}{% endfor %}]{% endcapture %}
<div data-poster-section="Journal" data-poster-id="{{ section.id }}" data-poster-blocks="{{ poster_articles | escape }}" data-poster-settings="{{ poster_settings | escape }}"></div>
{% schema %}
{
  "name": "文章展示",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Read something strange." },
    { "type": "blog", "id": "blog", "label": "选择博客" },
    { "type": "range", "id": "article_limit", "label": "展示文章数量", "min": 3, "max": 9, "step": 3, "default": 3 }
  ],
  "presets": [{ "name": "文章展示" }]
}
{% endschema %}
