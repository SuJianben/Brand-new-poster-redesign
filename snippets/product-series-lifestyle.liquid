{% liquid
  assign matched_series = blank

  for block in section.blocks
    assign configured_series = block.settings.collection
    if configured_series != blank
      for product_collection in product.collections
        if product_collection.id == configured_series.id
          assign matched_series = configured_series
          break
        endif
      endfor
    endif

    if matched_series != blank
      break
    endif
  endfor

  assign series_image = blank
  assign series_image_count = 0
  assign series_image_index = 0
  assign series_image_number = 0
  assign series_image_source = blank
  assign series_product_frame = ''
  if matched_series != blank
    assign series_images = matched_series.metafields.custom.lifestyle_images.value
    assign series_image_count = series_images.size

    if series_image_count > 0
      assign lifestyle_seed = product.id | divided_by: 1000
      assign series_image_index = lifestyle_seed | modulo: series_image_count
      assign series_image_number = series_image_index | plus: 1
      assign series_image_source = 'series_metafield'
    else
      assign series_image = matched_series.image | default: matched_series.featured_image
      if series_image != blank
        assign series_image_count = 1
        assign series_image_number = 1
        assign series_image_source = 'series_featured_image'
      endif
    endif
  endif

  if series_image_source == 'series_featured_image' and matched_series.image == blank
    assign series_first_product = matched_series.products.first
    if series_first_product.featured_image.src == series_image.src and series_image != blank
      capture series_product_frame
        render 'pf-black-frame-card', product: series_first_product
      endcapture
      assign series_product_frame = series_product_frame | strip
    endif
  endif

  assign fallback_image = section.settings.image
  assign lifestyle_source = 'bundled_fallback'
  assign lifestyle_alt = product.title | append: ' in a styled interior'

  if series_image_source == 'series_metafield'
    assign lifestyle_source = series_image_source
    assign lifestyle_alt = matched_series.title | append: ' collection'
  elsif series_image != blank
    assign lifestyle_source = series_image_source
    assign lifestyle_alt = series_image.alt | default: matched_series.title | append: ' collection'
  elsif fallback_image != blank
    assign lifestyle_source = 'section_fallback'
  endif
%}

<div
  class="ps-lifestyle ps-section"
  data-product-series-lifestyle
  data-lifestyle-renderer="series-media-preview-v1"
  data-lifestyle-source="{{ lifestyle_source }}"
  {% if matched_series != blank %}data-series-handle="{{ matched_series.handle | escape }}"{% endif %}
  {% if series_image_count > 0 %}data-lifestyle-image-count="{{ series_image_count }}"{% endif %}
  {% if series_image_number > 0 %}data-lifestyle-image-number="{{ series_image_number }}"{% endif %}
>
  {% if lifestyle_source == 'series_metafield' %}
    {% for candidate_media in series_images %}
      {% if forloop.index0 == series_image_index %}
        {% assign candidate_image = candidate_media.preview_image %}
        {% assign candidate_alt = candidate_media.alt | default: lifestyle_alt %}
        {{ candidate_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1200,1600,2200', alt: candidate_alt }}
        {% break %}
      {% endif %}
    {% endfor %}
  {% elsif series_product_frame != blank %}
    <div class="pf-series-frame" data-pf-series-frame>{{ series_product_frame }}</div>
  {% elsif series_image != blank %}
    {{ series_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1200,1600,2200', alt: lifestyle_alt }}
  {% elsif fallback_image != blank %}
    {{ fallback_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1200,1600,2200', alt: lifestyle_alt }}
  {% else %}
    <img src="{{ 'figma-lifestyle-hero.jpg' | asset_url }}" width="2200" height="1240" loading="lazy" alt="{{ lifestyle_alt | escape }}">
  {% endif %}
</div>
