{%- liquid
  assign odd_is_us = false
  if localization.country.iso_code == 'US' or cart.currency.iso_code == 'USD'
    assign odd_is_us = true
  endif
-%}
{%- case block.type -%}
  {%- when 'odd_benefits' -%}
    <div class="dw-postery-usps odd-info-block" {{ block.shopify_attributes }}>
      {%- for i in (1..4) -%}
        {%- assign key = 'item_' | append: i -%}
        {%- assign item = block.settings[key] -%}
        {%- if i == 4 and odd_is_us and block.settings.item_4_us != blank -%}{%- assign item = block.settings.item_4_us -%}{%- endif -%}
        {%- if item != blank -%}
          <div class="dw-postery-usp"><span class="dw-postery-usp__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">{%- case i -%}{%- when 1 -%}<path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/>{%- when 2 -%}<path d="M3 11a9 9 0 1 1 3 6.7M3 4v7h7"/>{%- when 3 -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>{%- when 4 -%}<path d="M3 5h11v12H3zM14 9h4l3 3v5h-7z"/><circle cx="7.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>{%- endcase -%}</svg></span><span>{{ item | escape }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- when 'odd_promotion' -%}
    <div class="dw-postery-promo-box odd-info-block" {{ block.shopify_attributes }}>
      {%- if block.settings.heading != blank -%}<strong>{{ block.settings.heading | escape }}</strong>{%- endif -%}
      {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
      {%- assign note = block.settings.note -%}{%- if odd_is_us and block.settings.note_us != blank -%}{%- assign note = block.settings.note_us -%}{%- endif -%}
      {%- if note != blank -%}<small>{{ note | escape }}</small>{%- endif -%}
    </div>
  {%- when 'odd_description' -%}
    {%- assign description = product.description | split: '</p>' | first | strip_html | strip | default: block.settings.fallback -%}
    {%- if description != blank -%}
      <div class="dw-postery-inline-desc odd-info-block" {{ block.shopify_attributes }}>
        <p class="dw-postery-inline-desc__text is-clamped">{{ description | escape }}</p>
        <button type="button" class="dw-postery-inline-desc__more" data-more-label="{{ block.settings.more_label | escape }}" data-less-label="{{ block.settings.less_label | escape }}" aria-expanded="false" hidden>{{ block.settings.more_label | escape }}</button>
      </div>
    {%- endif -%}
  {%- when 'odd_accordion' -%}
    <div class="dw-postery-meta-links odd-info-block odd-info-accordion" {{ block.shopify_attributes }}>
      <details class="dw-postery-meta-item"{% if block.settings.open %} open{% endif %}>
        <summary><span>{{ block.settings.heading | escape }}</span><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg></summary>
        <div class="dw-postery-meta-body">{%- if odd_is_us and block.settings.content_us != blank -%}{{ block.settings.content_us }}{%- else -%}{{ block.settings.content }}{%- endif -%}</div>
      </details>
    </div>
{%- endcase -%}
